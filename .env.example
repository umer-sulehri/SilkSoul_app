# Public Supabase project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon/publishable key. Safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret/service-role key. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical site URL used for metadata and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
